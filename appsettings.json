{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "default": "Data Source=JET-TB;Initial Catalog=proton;Integrated Security=True;Trust Server Certificate=True;Command Timeout=100000"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/api-log-.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  }
}


